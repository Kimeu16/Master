    "@types/express": "^5.0.3",
    "@types/node": "^24.0.1",
    "@types/papaparse": "^5.5.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3"
